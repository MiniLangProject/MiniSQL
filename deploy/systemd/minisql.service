[Unit]
Description=MiniSQL database server
After=network.target
Wants=network.target

[Service]
Type=simple
User=minisql
Group=minisql
WorkingDirectory=/var/lib/minisql
ExecStart=/opt/minisql/bin/minisqld --serve-config /var/lib/minisql/main /etc/minisql/minisql.json
ExecStop=/opt/minisql/bin/minisql --query 7432 SHUTDOWN
Restart=on-failure
RestartSec=5
TimeoutStopSec=90
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/minisql /var/log/minisql

[Install]
WantedBy=multi-user.target
